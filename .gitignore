# Secrets / local environment
.env
.env.*.local

# Claude Code local state — keep skills tracked so they're shared with the team.
# "**/" makes this apply to a .claude/ dir at any depth (a repo-root-only
# ".claude/*" would miss e.g. app01_Wordpress_mysql/.claude/).
**/.claude/*
!**/.claude/skills/

# Local scratch/dev-only state
tmp/
.local-dev/

# Self-signed TLS cert/key generated at container startup (SR-03, by the
# owasp/modsecurity-crs:nginx image itself) — regenerated per environment,
# never committed. "**/" for the same reason as .claude/ above.
**/nginx/certs/

# WPScan output (AS-03) — local scan artifacts, not something to version.
**/security-reports/

# Encrypted local backup artifacts (PLAN.md Phase 6) — not something to
# version, same reasoning as security-reports/ above.
**/backups/

# OS cruft
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/
*.swp

# PHP dependency dirs (not in use yet, but ignore if composer is ever added)
vendor/

# Node dependency dirs (not in use yet, but ignore if a JS build step is ever added)
node_modules/
