# Copy to .env and fill in real values. .env is gitignored — never commit it.

# --- MySQL ---
MYSQL_ROOT_PASSWORD=changeme-root-password
MYSQL_DATABASE=quantumai_wp
WP_DB_USER=quantumai_wp_app
WP_DB_PASSWORD=changeme-app-password

# --- WordPress ---
WP_TABLE_PREFIX=qai_
HTTP_PORT=8080

# nginx's HTTPS listener (SR-03). Every request to HTTP_PORT gets a 301 to
# this port; nginx auto-generates a self-signed cert for it on first start
# (see nginx/docker-entrypoint.d/) — replace that cert before deploying
# anywhere beyond local dev.
HTTPS_PORT=8443

# Secret login path (AS-01 "hide /wp-admin URL") — pick something
# unguessable per environment; the mu-plugin default ("portal-access") is
# only safe for local dev, not a real deployment.
WP_LOGIN_SLUG=changeme-secret-login-path

# --- WordPress secret keys/salts ---
# Generate a fresh set for every environment at:
# https://api.wordpress.org/secret-key/1.1/salt/
WORDPRESS_AUTH_KEY=
WORDPRESS_SECURE_AUTH_KEY=
WORDPRESS_LOGGED_IN_KEY=
WORDPRESS_NONCE_KEY=
WORDPRESS_AUTH_SALT=
WORDPRESS_SECURE_AUTH_SALT=
WORDPRESS_LOGGED_IN_SALT=
WORDPRESS_NONCE_SALT=

# --- Vulnerability scanning (AS-03) ---
# Required for `docker compose --profile scan run --rm wpscan` to do
# anything — wpscan 4.x's CLI calls the WPScan API to even start a scan, not
# just for extra CVE detail. Free token: https://wpscan.com/api/.
WPSCAN_API_TOKEN=

# --- Backups (PLAN.md Phase 6) ---
# Read-only DB user used only by `docker compose --profile backup run --rm
# backup` (db/init/02-create-backup-user.sh) — separate from WP_DB_USER so
# the backup process itself can never write/DROP anything, even if the
# backup container were fully compromised.
BACKUP_DB_USER=quantumai_wp_backup
BACKUP_DB_PASSWORD=changeme-backup-password

# DB user used only by `backup/restore.sh` (db/init/03-create-restore-user.sh)
# to actually import a dump — separate from both WP_DB_USER and
# BACKUP_DB_USER. See that script's doc comment for why: WP_DB_USER's (and
# root's) MySQL 8 default auth plugin can't be used by the mariadb-client
# tooling in the backup container at all, and WP_DB_USER also lacks the
# DROP privilege a full-dump restore needs.
RESTORE_DB_USER=quantumai_wp_restore
RESTORE_DB_PASSWORD=changeme-restore-password

# age (https://age-encryption.org) public recipient that encrypts every
# backup artifact. Generate the keypair yourself OUTSIDE this repo:
#   age-keygen -o backup-key.txt
# then paste the "# public key: age1..." value here. Keep backup-key.txt
# itself (the PRIVATE key) somewhere safe and offline (password manager,
# offline USB, etc.) — this project never generates or stores it, and
# losing it makes every backup permanently unreadable. Treat it with at
# least the care you'd give MYSQL_ROOT_PASSWORD.
BACKUP_AGE_RECIPIENT=

# How many days of local encrypted backups to keep in ./backups before a
# backup run prunes them (mirrors the audit-log mu-plugin's own retention
# pattern). S3 copies, if configured below, are governed by the bucket's
# own lifecycle/Object Lock policy instead — an independent window, not
# tied to this value. See README "Backups".
BACKUP_RETENTION_DAYS=30

# Optional off-site upload leg — attempted only if AWS_ACCESS_KEY_ID and
# BACKUP_S3_BUCKET are both set; otherwise the backup completes
# local-only and this step is skipped with a log message, not a hard
# failure. Not verified against a real AWS account/bucket from this
# environment — see README "Backups" for exactly what that means.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=quantumai-wp
