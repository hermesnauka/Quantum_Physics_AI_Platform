server_tokens off;

upstream wordpress_backend {
    server wordpress:80;
}

# NFR-01/02: anonymous-page microcache. A cache HIT never reaches PHP/MySQL at
# all, which is both the "<2s globally" requirement (NFR-01) and the "handle
# traffic spikes" requirement (NFR-02) — a viral post gets served almost
# entirely out of this cache instead of re-rendering per visitor.
#
# 60s TTL is a deliberate trade-off for a "fast-paced news" site: a newly
# published or edited post can take up to a minute to reach an anonymous
# visitor who already had the old version cached. Tighter freshness would need
# an active purge-on-publish hook (not implemented here) instead of a fixed
# TTL; if that staleness window ever becomes a real complaint, that's the
# next thing to build, not a shorter TTL (which just trades cache hit-rate
# for the same underlying problem).
proxy_cache_path /var/cache/nginx/wp levels=1:2 keys_zone=wp_cache:10m max_size=200m inactive=10m use_temp_path=off;

# Never serve a cached page to a request that carries any cookie implying
# personalized/sensitive content: a logged-in session, a just-submitted
# (still-pending-moderation) comment, or a post-visible-by-password cookie.
map $http_cookie $quantumai_cookie_bypass {
    default 0;
    "~*wordpress_logged_in_" 1;
    "~*comment_author_" 1;
    "~*wp-postpass_" 1;
}

# SR-03: every plain-HTTP request gets redirected straight to HTTPS — nothing
# else is served on :80. `$host` strips whatever port the client actually
# connected on, so the explicit `${HTTPS_PORT}` below (baked in at container
# start by the envsubst-on-templates entrypoint step, from the HTTPS_PORT
# env var) is what makes this correct for a non-standard port like the 8443
# used for local dev — a bare "https://$host" would silently imply :443.
server {
    listen 80;
    server_name _;
    return 301 https://$host:${HTTPS_PORT}$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name _;

    # SR-03: self-signed for local dev, generated on first container start by
    # nginx/docker-entrypoint.d/40-quantumai-tls-setup.sh and persisted in the
    # bind-mounted nginx/certs/ (gitignored). Swap these two files for a
    # CA-issued cert/key — or terminate TLS at Cloudflare instead and drop
    # this server block — before this stack is reachable from the public
    # internet; see the README's "Post-install hardening checklist".
    ssl_certificate     /etc/nginx/certs/wordpress.crt;
    ssl_certificate_key /etc/nginx/certs/wordpress.key;

    # TLS 1.3 only, per SR-03's literal wording. Trade-off: a client that
    # can't do 1.3 (a legacy/embedded HTTP client, not any current browser)
    # gets a hard handshake failure instead of a 1.2 fallback. Add "TLSv1.2"
    # here if that ever turns out to matter in practice. No ssl_ciphers list
    # needed — TLS 1.3's own cipher suite selection is already restricted to
    # strong AEAD ciphers and isn't tunable via that directive.
    ssl_protocols TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    client_max_body_size 32m;

    # SR-05 / AS-01: block WordPress XML-RPC, a common brute-force amplification
    # and pingback-DDoS vector (also disabled at the app layer in wp-config).
    location = /xmlrpc.php {
        deny all;
        return 403;
    }

    # Never serve config or dotfiles even if a misconfigured plugin exposes them.
    location ~* wp-config\.php$ {
        deny all;
    }
    location ~ /\.(?!well-known) {
        deny all;
    }

    # PHP execution is not allowed inside the uploads directory (defense against
    # AS-03 style RCE-via-upload).
    location ~* /wp-content/uploads/.*\.php$ {
        deny all;
    }

    location / {
        proxy_pass http://wordpress_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Bypass the cache entirely for anything that isn't a plain,
        # anonymous GET of a "normal" URL: form submissions, admin/login
        # (also blocked outright at the app layer, but never cache them
        # regardless), the REST API, feeds, and any URL with a query string
        # (search results, utm-tagged links, etc. — each would otherwise
        # become its own cache entry with no real hit-rate benefit).
        set $quantumai_skip_cache 0;
        if ($request_method != GET) {
            set $quantumai_skip_cache 1;
        }
        if ($query_string != "") {
            set $quantumai_skip_cache 1;
        }
        if ($request_uri ~* "^/(wp-admin/|wp-login\.php|wp-json/|feed/|wp-cron\.php)") {
            set $quantumai_skip_cache 1;
        }
        if ($quantumai_cookie_bypass = 1) {
            set $quantumai_skip_cache 1;
        }

        proxy_cache wp_cache;
        proxy_cache_key "$scheme$request_method$host$request_uri";
        proxy_cache_valid 200 60s;
        proxy_cache_bypass $quantumai_skip_cache;
        proxy_no_cache $quantumai_skip_cache;
        # Ignore whatever Cache-Control/Expires the backend sends — this
        # directive set is the single source of truth for cache behavior,
        # rather than being at the mercy of whatever WP core or a future
        # plugin happens to emit.
        proxy_ignore_headers Cache-Control Expires;
        # Under a spike, only one request per stale/expired cache key hits
        # PHP to refresh it; everyone else gets the stale copy instead of
        # all piling onto the backend at once (the actual NFR-02 mechanism).
        proxy_cache_lock on;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_cache_background_update on;
    }

    # PLAN.md Phase 2 "Content Security Policy (CSP) headers". This policy is
    # intentionally permissive (unsafe-inline/unsafe-eval) because the stock
    # WP block editor and admin dashboard need it. Tighten this once the theme
    # and plugin set are finalized.
    #
    # Deliberately kept all in one place, at server level: nginx only inherits
    # a parent context's add_header directives into a location if that
    # location defines *none* of its own — add a single add_header inside
    # `location /` (e.g. for cache-status debugging) and every header below
    # silently stops being sent for any request that location handles, with
    # no warning at config-test time. Learned this the hard way while adding
    # the microcache below: X-Cache-Status inside `location /` wiped the CSP
    # and every other header here. If you need a location-specific header,
    # repeat the full set in that location rather than adding just the new
    # one.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; frame-ancestors 'self';" always;
    add_header X-Cache-Status $upstream_cache_status always;
    # SR-03: pin browsers to HTTPS for this host going forward. Only sent from
    # this (the HTTPS) server block — the plain-HTTP one above only ever
    # returns a redirect, so there's no path where a client sees this over an
    # unencrypted connection first.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
}
